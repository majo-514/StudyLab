---
import Layout from '../layouts/Layout.astro';
import Library from '../components/Library';
import {chapters,lessons,listItems} from '../lib/catalog';
const exercises=listItems(lessons.filter(entry=>entry.kind==='problem'));
---
<Layout title="习题训练"><h1>习题训练</h1>
  <Library mode="practice" entries={exercises} chapters={chapters} client:load/>
</Layout>
